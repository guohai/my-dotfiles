+static bool read_ps_long(const char *base, const char *dev,
+		const char *attr, long long *out) {
+	char path[512];
+	char buf[64];
+	snprintf(path, sizeof(path), "%s/%s/%s", base, dev, attr);
+	FILE *f = fopen(path, "r");
+	if (!f) {
+		return false;
+	}
+	bool ok = fgets(buf, sizeof(buf), f) != NULL;
+	fclose(f);
+	if (!ok) {
+		return false;
+	}
+	char *end;
+	long long v = strtoll(buf, &end, 10);
+	if (end == buf) {
+		return false;
+	}
+	*out = v;
+	return true;
+}
