+			}
+			memcpy(bbuf + out, sub, len);
+			out += len;
+			in += skip;
+		} else {
+			bbuf[out++] = *in++;
+		}
+	}
+	bbuf[out] = '\0';
+	*bstr = bbuf;
+}
