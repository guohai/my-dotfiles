+		const char *sub = NULL;
+		char num[8];
+		size_t skip = 0;
+
+		if (strncmp(in, "{p}", 3) == 0) {
+			snprintf(num, sizeof(num), "%d", percent);
+			sub = num;
+			skip = 3;
+		} else if (strncmp(in, "{icon}", 6) == 0) {
+			sub = icon;
+			skip = 6;
+		}
+
+		if (sub) {
+			size_t len = strlen(sub);
+			if (out + len + 1 > sizeof(bbuf)) {
