+		"\xf3\xb0\x81\xbc", "\xf3\xb0\x81\xbd", "\xf3\xb0\x81\xbe",
+		"\xf3\xb0\x81\xbf", "\xf3\xb0\x82\x80", "\xf3\xb0\x82\x81",
+		"\xf3\xb0\x82\x82", "\xf3\xb0\x81\xb9",
+	};
+	const char *icon = charging ? "\xf3\xb0\x82\x84" : levels[percent / 10];
