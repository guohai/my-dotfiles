+// Charge level of the first battery under /sys/class/power_supply, plus
+// whether it is charging. False when the machine has no battery at all, in
+// which case the caller drops the line rather than printing a placeholder.
+static bool battery_status(int *percent, bool *charging) {
+	static const char *base = "/sys/class/power_supply";
+	DIR *dir = opendir(base);
+	if (!dir) {
+		return false;
+	}
+
+	bool found = false;
+	struct dirent *ent;
+	while (!found && (ent = readdir(dir)) != NULL) {
+		char path[512];
+		char buf[64];
+		FILE *f;
+		long long now, full, cap;
+
+		snprintf(path, sizeof(path), "%s/%s/type", base, ent->d_name);
+		if (!(f = fopen(path, "r"))) {
+			continue;
+		}
+		bool is_battery = fgets(buf, sizeof(buf), f) &&
+			strncmp(buf, "Battery", 7) == 0;
+		fclose(f);
+		if (!is_battery) {
+			continue;
+		}
+
+		// Compute now/full rather than trusting the kernel's own
+		// `capacity` attribute. Not every driver defines `capacity` the
+		// same way: the SBS driver on Apple laptops divides by
+		// charge_full_DESIGN, so a worn cell reads far lower there than
+		// it does in upower -- 57% against 83% on the machine this was
+		// written for, a battery at 68% health after 518 cycles. Nothing
+		// else the user can see reports the design-relative number, so
+		// the lock screen would be the odd one out.
+		//
+		// now/full is charge as a fraction of what the cell holds
+		// *today*, which is what upower, GNOME and the Quickshell bar
+		// all show. Drivers report either charge_* (uAh) or energy_*
+		// (uWh) -- try both, then fall back to `capacity` for anything
+		// exotic that publishes neither.
+		//
+		// upower's own percentage runs two to three points under this
+		// on a discharging cell, because it scales by voltage_now. The
+		// bar reads these two files rather than upower, so it agrees.
+		if ((read_ps_long(base, ent->d_name, "charge_now", &now) &&
+				read_ps_long(base, ent->d_name, "charge_full", &full) &&
+				full > 0) ||
+			(read_ps_long(base, ent->d_name, "energy_now", &now) &&
+				read_ps_long(base, ent->d_name, "energy_full", &full) &&
+				full > 0)) {
+			// Round to nearest, like everything else does. Truncating
+			// would sit a point low for most of the battery's life.
+			*percent = (int)((now * 100 + full / 2) / full);
+			found = true;
+		} else if (read_ps_long(base, ent->d_name, "capacity", &cap)) {
+			*percent = (int)cap;
+			found = true;
+		}
+		if (!found) {
+			continue;
+		}
+
+		// A full cell often reads slightly over its own charge_full.
+		if (*percent < 0) {
+			*percent = 0;
+		} else if (*percent > 100) {
+			*percent = 100;
+		}
+
+		*charging = false;
+		snprintf(path, sizeof(path), "%s/%s/status", base, ent->d_name);
+		if ((f = fopen(path, "r"))) {
+			if (fgets(buf, sizeof(buf), f)) {
+				*charging = strncmp(buf, "Charging", 8) == 0 ||
+					strncmp(buf, "Full", 4) == 0;
+			}
+			fclose(f);
+		}
+	}
+	closedir(dir);
+	return found;
+}
